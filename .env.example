# Kopieren nach .env und ausfüllen (Supabase → Project Settings → API)

# Für die App (Build/Dev) — der anon key ist öffentlich, RLS schützt die Daten
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Nur für das Import-Script (npm run import) — service_role key GEHEIM halten
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
